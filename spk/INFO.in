package="SynetScan"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="SynetScan"
description="Discover and monitor every device on your local network. SynetScan finds computers, phones, printers, TVs and smart-home devices, identifies them by vendor, host name and services, and alerts you about new devices."
description_ger="Finden und überwachen Sie alle Geräte in Ihrem lokalen Netzwerk. SynetScan erkennt Computer, Smartphones, Drucker, Fernseher und Smart-Home-Geräte, identifiziert sie anhand von Hersteller, Hostname und Diensten und meldet neue Geräte."
maintainer="Philip Hohn"
arch="noarch"
dsmuidir="ui"
dsmappname="SYNO.SDS.SynetScan.Instance"
thirdparty="yes"
silent_upgrade="yes"
ctl_stop="yes"
startable="yes"
create_time="@CREATE_TIME@"
checksum="@CHECKSUM@"
