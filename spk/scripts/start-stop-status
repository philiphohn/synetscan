#!/bin/sh
# SynetScan service control (DSM: start | stop | status | log)
. "$(dirname "$0")/common"
PID_FILE="$PKG_VAR/synetscand.pid"
LOG_FILE="$PKG_VAR/synetscan.log"

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start_daemon() {
    is_running && return 0
    mkdir -p "$PKG_VAR"
    umask 077  # the service's data, log and pid file are private to the package user
    rm -f "$PKG_VAR/synetscan.sock"  # one left by a killed service would pass for a started one
    SYNOPKG_PKGVAR="$PKG_VAR" nohup "$PKG_TARGET/bin/synetscand" "$LOG_FILE" >> "$PKG_VAR/daemon.out" 2>&1 &
    echo $! > "$PID_FILE"
    i=0
    while [ $i -lt 10 ]; do
        [ -S "$PKG_VAR/synetscan.sock" ] && return 0
        is_running || break
        sleep 1
        i=$((i + 1))
    done
    is_running
}

stop_daemon() {
    if is_running; then
        PID=$(cat "$PID_FILE")
        kill -TERM "$PID" 2>/dev/null
        i=0
        while [ $i -lt 15 ] && kill -0 "$PID" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        kill -0 "$PID" 2>/dev/null && kill -KILL "$PID" 2>/dev/null
    fi
    rm -f "$PID_FILE"
}

case "$1" in
    start)
        start_daemon || { log_ui "SynetScan service failed to start, see $LOG_FILE"; exit 1; }
        exit 0 ;;
    stop)
        stop_daemon
        exit 0 ;;
    status)
        is_running && exit 0
        exit 3 ;;
    log)
        echo "$LOG_FILE"
        exit 0 ;;
    *)
        exit 1 ;;
esac
